((author "Meowster")
 (synopsis "Bindings for raylib: A simple and easy-to-use library to enjoy videogames programming")
 (version "2.3.0")
 (license "MIT")
 (category graphics)
 (components
   (extension raylib
     (custom-build "build.sh"))
   (extension rlgl
     (custom-build "build.sh"))
   (extension raymath
     (custom-build "build.sh"))
     ))
